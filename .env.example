# The server reads these from the process environment (it does not load .env files).
# Example (PowerShell):  $env:PORT = "3100"; npm run dev
# Example (bash):        PORT=3100 npm run dev
# All values are optional.

# Port and bind address of the Express server.
# The server has no authentication: keep HOST on loopback unless you are on a trusted network.
# PORT=3000
# HOST=127.0.0.1

# Python interpreter that has python/requirements.txt installed.
# Default: .venv created by `npm run setup:python`.
# SENSORCLEAN_PYTHON=
